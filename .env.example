# ==========================================
# MargDarshan Environment Configuration
# Team: GravityX | Ministry of Tribal Affairs (MoTA)
# ==========================================

# Database Configuration (Defaults to SQLite for instant local zero-setup execution, PostgreSQL for Docker)
DATABASE_URL=sqlite:///./margdarshan.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/margdarshan

# Redis Cache & Sessions (Optional for local, included in docker-compose)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=margdarshan_gravityx_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration (SAATHI Companion)
# Supported providers: mock, gemini, openai, openrouter
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OCR Provider Configuration (mock / tesseract)
OCR_PROVIDER=mock

# Storage Configuration (local / s3)
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# Prototype & Demonstration Settings
DEMO_MODE=true
SIMULATED_FAILURES_ENABLED=true
